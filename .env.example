# StalkChain Data — https://data.stalkchain.com/dashboard (API keys start with sc_)
# Powers the Python research client. For Cursor MCP, sign in via OAuth when adding the
# stalkchain server, or add Authorization: Bearer ${env:STALKCHAIN_API_KEY} under headers
# in .cursor/mcp.json (see https://data.stalkchain.com/llms.txt).
STALKCHAIN_API_KEY=

# Optional overrides (defaults match StalkChain production)
# STALKCHAIN_API_BASE=https://data.stalkchain.com/api/v1

# Existing arena notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
